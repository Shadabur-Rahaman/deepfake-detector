{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "backend/**",
      "frontend/**",
      "requirements.txt",
      "gunicorn.conf.py",
      "run.py",
      "Dockerfile",
      "ml_artifacts/**",
      "advanced_models/**"
    ]
  },
  "deploy": {
    "healthcheckPath": "/v1/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "startCommand": null,
    "env": {
      "FORCE_CPU_MODE": "1",
      "PYTHONUNBUFFERED": "1",
      "PORT": "8000",
      "DEVELOPMENT_MODE": "false",
      "MAX_CONCURRENT_JOBS": "2",
      "LOG_LEVEL": "info",
      "CORS_ORIGINS": ""
    }
  }
}
