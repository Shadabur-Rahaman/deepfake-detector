# =============================================================================
# DEEPFAKE DETECTION SYSTEM - CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to 'config.env' and update the values with your settings
# IMPORTANT: Never commit config.env to version control!

# =============================================================================
# REQUIRED API KEYS (System requires these for full functionality)
# =============================================================================
# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Get your Gemini API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# SQLite (default - no setup required, works out of the box)
DATABASE_URL=sqlite:///./deepfake_detection.db

# For production PostgreSQL (optional):
# DATABASE_URL=postgresql://user:password@localhost:5432/deepfake_detection

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Generate a secure random key (32+ characters)
# You can use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-at-least-32-characters-long

# JWT Configuration
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Host and port for the backend server
HOST=0.0.0.0
PORT=8000

# CORS Configuration (Frontend URLs)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# AI MODEL CONFIGURATION
# =============================================================================
# CPU Mode (Default - works without GPU)
# Set to 1 for CPU-only mode (recommended for beginners)
FORCE_CPU_MODE=1
CUDA_VISIBLE_DEVICES=

# Optional: Enable GPU (if you have NVIDIA GPU with CUDA)
# FORCE_CPU_MODE=0
# CUDA_VISIBLE_DEVICES=0

# =============================================================================
# DETECTION SETTINGS
# =============================================================================
# Maximum file size for uploads (in MB)
MAX_FILE_SIZE_MB=100

# Detection timeout (in seconds)
DETECTION_TIMEOUT_SECONDS=300

# Maximum concurrent detections
MAX_CONCURRENT_DETECTIONS=10

# Allowed file types
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/avi,video/mov,video/wmv

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable audit logging
AUDIT_LOG_ENABLED=true

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Development mode (set to false for production)
DEVELOPMENT_MODE=true

# API rate limiting
API_RATE_LIMIT_ENABLED=true

# Security headers
SECURITY_HEADERS_ENABLED=true

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================
# SMTP settings for user notifications (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# =============================================================================
# REDIS CONFIGURATION (Optional)
# =============================================================================
# Redis for caching and sessions (optional)
REDIS_URL=redis://localhost:6379

# =============================================================================
# MONITORING CONFIGURATION (Optional)
# =============================================================================
# Security monitoring
SECURITY_MONITORING_ENABLED=true
ALERT_EMAIL=security@deepfake-detector.com

# =============================================================================
# NOTES
# =============================================================================
# 1. OpenAI and Gemini API keys are REQUIRED for full functionality
# 2. The system will work in limited mode without these keys
# 3. Generate a secure SECRET_KEY for production use
# 4. CPU mode works perfectly and is recommended for beginners
# 5. GPU mode requires NVIDIA GPU with CUDA 12.1+ support