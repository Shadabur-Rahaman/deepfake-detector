# Copy this file to config.env and fill in your values.
# Never commit config.env.

# Optional external APIs (local models still work without these)
ENABLE_EXTERNAL_AI_APIS=false
ENABLE_OPENAI_API=false
ENABLE_CLAUDE_API=false
ENABLE_GEMINI_API=false
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
INFURA_API_KEY=

# Database
DATABASE_URL=sqlite:///./deepfake_detection.db

# Security — generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Optional public API key. Empty = open local API. If set, send header X-API-Key.
PUBLIC_API_KEY=
REQUIRE_AUTH=false
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# Device: CPU by default (set FORCE_CPU_MODE=0 if you have a working NVIDIA GPU)
FORCE_CPU_MODE=1
CUDA_VISIBLE_DEVICES=

# Uploads
MAX_FILE_SIZE_MB=100
DETECTION_TIMEOUT_SECONDS=300
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/avi,video/mov,video/wmv

# Mail — Gmail inbox OTP (use an App Password, not your Gmail login password)
# Google Account → Security → 2-Step Verification → App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# SMS OTP (Twilio). Leave empty to verify email only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

LOG_LEVEL=INFO
DEVELOPMENT_MODE=true
MAX_CONCURRENT_JOBS=2
UVICORN_WORKERS=1

